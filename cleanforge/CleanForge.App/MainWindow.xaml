<Window x:Class="CleanForge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CleanForge.App"
        xmlns:models="clr-namespace:CleanForge.Core.Models;assembly=CleanForge.Core"
        Title="CleanForge Pro v1.0 — Nettoyeur Profond, Explorateur Total &amp; Optimiseur Sûr"
        Width="1320" Height="820"
        MinWidth="1060" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgObsidian}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:TabVisibilityConverter x:Key="TabVis" />
        <local:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="246" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================== LEFT NAVIGATION SIDEBAR ==================== -->
        <Border Grid.Column="0" Background="{StaticResource BgSidebar}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <!-- Brand Header -->
                <StackPanel DockPanel.Dock="Top" Margin="16,18,16,14">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="34" Height="34" CornerRadius="8" Background="{StaticResource AccentEmeraldDim}" BorderBrush="{StaticResource AccentEmerald}" BorderThickness="1.5">
                            <TextBlock Text="CF" FontWeight="Bold" FontSize="14" Foreground="{StaticResource AccentEmerald}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="CLEANFORGE PRO" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextPrimary}" />
                            <TextBlock Text="v1.0 · ZÉRO RISQUE PC" FontSize="10.5" Foreground="{StaticResource AccentCyan}" FontWeight="SemiBold" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Safety Footer in Sidebar -->
                <Border DockPanel.Dock="Bottom" Margin="12" Padding="12" CornerRadius="9" Background="{StaticResource AccentEmeraldDim}" BorderBrush="#1F5F4E" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="BOUCLIER SAFETYGUARD ACTIF" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource AccentEmerald}" />
                        <TextBlock Text="System32, Pilotes, Defender, mots de passe navigateurs et fichiers Cloud strictement verrouillés."
                                   TextWrapping="Wrap" FontSize="11" Foreground="#B7E4D8" Margin="0,4,0,8" />
                        <Button Content="Ouvrir journaux d'audit" Style="{StaticResource SecondaryButton}" Command="{Binding OpenLogsFolderCommand}" FontSize="11.5" Padding="8,5" />
                    </StackPanel>
                </Border>

                <!-- Navigation Rail Tabs -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,4">
                        <TextBlock Text="ANALYSE &amp; NETTOYAGE" Margin="16,6,16,4" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}" />
                        <RadioButton Style="{StaticResource NavTabRadio}" GroupName="Nav" IsChecked="True" Tag="0" Checked="OnNavChecked">
                            <StackPanel>
                                <TextBlock Text="Tableau de Bord" />
                                <TextBlock Text="{Binding TotalReclaimableFormatted, StringFormat='{}{0} récupérables'}" FontSize="10.5" Foreground="{StaticResource AccentEmerald}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavTabRadio}" GroupName="Nav" Tag="1" Checked="OnNavChecked">
                            <StackPanel>
                                <TextBlock Text="Explorateur Total PC" />
                                <TextBlock Text="Tout détecter · Tous disques" FontSize="10.5" Foreground="{StaticResource TextMuted}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavTabRadio}" GroupName="Nav" Tag="2" Checked="OnNavChecked">
                            <StackPanel>
                                <TextBlock Text="Caches Profonds (60+)" />
                                <TextBlock Text="{Binding CacheTotalFormatted}" FontSize="10.5" Foreground="{StaticResource AccentCyan}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavTabRadio}" GroupName="Nav" Tag="3" Checked="OnNavChecked">
                            <StackPanel>
                                <TextBlock Text="Mode Fin d'Études" />
                                <TextBlock Text="{Binding StudyTotalFormatted}" FontSize="10.5" Foreground="{StaticResource AccentViolet}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavTabRadio}" GroupName="Nav" Tag="4" Checked="OnNavChecked">
                            <StackPanel>
                                <TextBlock Text="Doublons SHA-256" />
                                <TextBlock Text="{Binding DuplicateTotalFormatted}" FontSize="10.5" Foreground="{StaticResource AccentAmber}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavTabRadio}" GroupName="Nav" Tag="5" Checked="OnNavChecked">
                            <StackPanel>
                                <TextBlock Text="Logiciels &amp; Fantômes" />
                                <TextBlock Text="{Binding GhostCountText}" FontSize="10.5" Foreground="{StaticResource TextMuted}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavTabRadio}" GroupName="Nav" Tag="6" Checked="OnNavChecked">
                            <StackPanel>
                                <TextBlock Text="Raccourcis &amp; Dossiers Vides" />
                                <TextBlock Text="{Binding ShortcutEmptyCountText}" FontSize="10.5" Foreground="{StaticResource TextMuted}" />
                            </StackPanel>
                        </RadioButton>

                        <TextBlock Text="OPTIMISATION SÛRE" Margin="16,14,16,4" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}" />
                        <RadioButton Style="{StaticResource NavTabRadio}" GroupName="Nav" Tag="7" Checked="OnNavChecked">
                            <StackPanel>
                                <TextBlock Text="Optimiseur &amp; Démarrage" />
                                <TextBlock Text="4 Profils · 0% risque matériel" FontSize="10.5" Foreground="{StaticResource AccentEmerald}" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ==================== MAIN CONTENT WORKSPACE ==================== -->
        <DockPanel Grid.Column="1" LastChildFill="True">
            <!-- Top Header Bar (Safety Switches + Admin Badge) -->
            <Border DockPanel.Dock="Top" Background="#0E1422" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1" Padding="20,11">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Padding="8,4" CornerRadius="6" Background="{StaticResource AccentEmeraldDim}" BorderBrush="#1F5F4E" BorderThickness="1">
                            <TextBlock Text="{Binding ActionModeBanner}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource AccentEmerald}" />
                        </Border>
                        <CheckBox Content="Corbeille Windows (Sûr)" IsChecked="{Binding UseRecycleBin}" Margin="16,0,0,0" FontSize="12" />
                        <CheckBox Content="Mode Simulation (À blanc)" IsChecked="{Binding IsDryRun}" Margin="14,0,0,0" FontSize="12" Foreground="{StaticResource AccentAmber}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Padding="9,4" CornerRadius="6" Background="{StaticResource BgElevated}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" Margin="0,0,8,0">
                            <TextBlock Text="{Binding AdminBadgeText}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" />
                        </Border>
                        <Button Content="Passer en Admin (UAC)"
                                Style="{StaticResource AmberButton}"
                                Command="{Binding RelaunchAsAdminCommand}"
                                Visibility="{Binding ShowElevateButton, Converter={StaticResource BoolToVis}}"
                                Padding="10,5" FontSize="11.5" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Bottom Live Status & Progress Bar -->
            <Border DockPanel.Dock="Bottom" Background="#0E1422" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0" Padding="20,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <Grid Margin="0,0,0,5">
                            <TextBlock Text="{Binding ProgressStage}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding ProgressPath}" FontSize="11" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right" MaxWidth="460" TextTrimming="CharacterEllipsis" />
                        </Grid>
                        <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="ANNULER"
                            Style="{StaticResource DangerButton}"
                            Command="{Binding CancelActiveScanCommand}"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                            Margin="14,0,0,0" Padding="14,6" />
                </Grid>
            </Border>

            <!-- ==================== ACTIVE VIEW AREA ==================== -->
            <Grid Margin="20,16">

                <!-- TAB 0: DASHBOARD -->
                <ScrollViewer Visibility="{Binding SelectedTabIndex, Converter={StaticResource TabVis}, ConverterParameter=0}" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Hero Action Card -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Diagnostic Complet &amp; Nettoyage Intelligent du PC" FontSize="20" FontWeight="Bold" />
                                    <TextBlock Text="Scanne tous vos disques, caches profonds, projets/fichiers de fin d'études, doublons SHA-256, logiciels fantômes et raccourcis cassés sans jamais toucher au système."
                                               Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,5,16,0" FontSize="13" />
                                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource AccentCyan}" Margin="0,10,0,0" FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Button Content="LANCER L'ANALYSE COMPLÈTE"
                                            Style="{StaticResource PrimaryButton}"
                                            Command="{Binding FullPcScanCommand}"
                                            Padding="22,13" FontSize="14" />
                                    <TextBlock Text="Lecture seule · Aucune suppression automatique" FontSize="10.5" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,5,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- KPI Summary Cards -->
                        <UniformGrid Columns="4" Margin="0,0,0,14">
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="ESPACE RÉCUPÉRABLE TOTAL" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextMuted}" />
                                    <TextBlock Text="{Binding TotalReclaimableFormatted}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentEmerald}" Margin="0,4,0,2" />
                                    <TextBlock Text="Caches + Études + Doublons + Orphelins" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardBorder}" Margin="4,0">
                                <StackPanel>
                                    <TextBlock Text="CACHES PROPONDS (60+)" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextMuted}" />
                                    <TextBlock Text="{Binding CacheTotalFormatted}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentCyan}" Margin="0,4,0,2" />
                                    <TextBlock Text="Windows, Navigateurs, GPU, Apps" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardBorder}" Margin="4,0">
                                <StackPanel>
                                    <TextBlock Text="MODE FIN D'ÉTUDES" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextMuted}" />
                                    <TextBlock Text="{Binding StudyTotalFormatted}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentViolet}" Margin="0,4,0,2" />
                                    <TextBlock Text="Builds Dev, Installeurs, Vieux Docs" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardBorder}" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="DOUBLONS EXACTS SHA-256" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextMuted}" />
                                    <TextBlock Text="{Binding DuplicateTotalFormatted}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentAmber}" Margin="0,4,0,2" />
                                    <TextBlock Text="100 % bit-identiques · Originaux verrouillés" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Hardware & Drives Telemetry -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="DISQUES LOCAUX DÉTECTÉS" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentCyan}" Margin="0,0,0,10" />
                                    <ItemsControl ItemsSource="{Binding Drives}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource BgElevated}" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                                    <StackPanel>
                                                        <Grid Margin="0,0,0,6">
                                                            <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" FontSize="13" />
                                                            <TextBlock HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource TextSecondary}">
                                                                <Run Text="{Binding FreeFormatted, Mode=OneWay}" Foreground="{StaticResource AccentEmerald}" FontWeight="SemiBold" />
                                                                <Run Text=" libres / " />
                                                                <Run Text="{Binding TotalFormatted, Mode=OneWay}" />
                                                            </TextBlock>
                                                        </Grid>
                                                        <ProgressBar Value="{Binding UsedPercent, Mode=OneWay}" Maximum="100" Height="7" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="ÉTAT SYSTÈME &amp; SÉCURITÉ" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentEmerald}" Margin="0,0,0,10" />
                                    <TextBlock Text="{Binding Health.MachineName, StringFormat='PC : {0}'}" FontSize="13" Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding Health.OsDescription, StringFormat='OS : {0}'}" FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding Health.CpuLogicalCores, StringFormat='Processeur : {0} cœurs logiques (scan parallèle)'}" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding Health.RamFormatted, StringFormat='Mémoire RAM : {0}'}" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,10" />
                                    <TextBlock Text="{Binding DiskScanSummaryText, StringFormat='Index PC : {0}'}" FontSize="12" Foreground="{StaticResource AccentCyan}" Margin="0,0,0,12" />
                                    <Border Background="{StaticResource BgElevated}" CornerRadius="8" Padding="10">
                                        <TextBlock Text="Garanties CleanForge Pro :&#x0a;• Aucun overclocking / tension / réglage BIOS&#x0a;• Aucune suppression dans System32 / WinSxS / Pilotes&#x0a;• Mots de passe, cookies et favoris navigateurs intacts&#x0a;• Sauvegarde auto avant chaque optimisation Windows"
                                                   FontSize="11.5" Foreground="#CBD5E1" TextWrapping="Wrap" LineHeight="18" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- TAB 1: FULL PC DISK EXPLORER & INSTANT GLOBAL SEARCH -->
                <DockPanel Visibility="{Binding SelectedTabIndex, Converter={StaticResource TabVis}, ConverterParameter=1}">
                    <Border DockPanel.Dock="Top" Style="{StaticResource CardBorder}" Margin="0,0,0,12" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Explorateur Total du PC &amp; Recherche Universelle" FontSize="17" FontWeight="Bold" />
                                    <TextBlock Text="Trouve instantanément n'importe quel fichier ou dossier sur tous les disques, classé du plus lourd au plus léger." FontSize="12" Foreground="{StaticResource TextSecondary}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Scanner Tous les Disques" Style="{StaticResource CyanButton}" Command="{Binding ScanExplorerCommand}" Margin="0,0,8,0" />
                                    <Button Content="Ouvrir dans l'Explorateur" Style="{StaticResource SecondaryButton}" Command="{Binding OpenInExplorerCommand}" CommandParameter="{Binding SelectedExplorerNode.FullPath}" Margin="0,0,8,0" />
                                    <Button Content="Corbeille (Sélection)" Style="{StaticResource DangerButton}" Command="{Binding DeleteExplorerItemCommand}" CommandParameter="{Binding SelectedExplorerNode}" />
                                </StackPanel>
                            </Grid>

                            <!-- Global Search Controls -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBox Width="280" Text="{Binding GlobalSearchQuery, UpdateSourceTrigger=PropertyChanged}" ToolTip="Rechercher par nom ou chemin partout sur le PC..." />
                                <TextBlock Text="Extension :" VerticalAlignment="Center" Margin="12,0,6,0" Foreground="{StaticResource TextSecondary}" FontSize="12" />
                                <TextBox Width="76" Text="{Binding GlobalSearchExt, UpdateSourceTrigger=PropertyChanged}" ToolTip=".iso, .mp4, .pdf, .zip..." />
                                <TextBlock Text="Min (Mo) :" VerticalAlignment="Center" Margin="12,0,6,0" Foreground="{StaticResource TextSecondary}" FontSize="12" />
                                <TextBox Width="60" Text="{Binding GlobalSearchMinMb, UpdateSourceTrigger=PropertyChanged}" />

                                <Button Content="Tout" Style="{StaticResource SecondaryButton}" Tag="" Click="OnQuickExtFilterClick" Margin="12,0,4,0" Padding="8,4" FontSize="11" />
                                <Button Content=".mp4" Style="{StaticResource SecondaryButton}" Tag=".mp4" Click="OnQuickExtFilterClick" Margin="2,0" Padding="8,4" FontSize="11" />
                                <Button Content=".zip" Style="{StaticResource SecondaryButton}" Tag=".zip" Click="OnQuickExtFilterClick" Margin="2,0" Padding="8,4" FontSize="11" />
                                <Button Content=".iso" Style="{StaticResource SecondaryButton}" Tag=".iso" Click="OnQuickExtFilterClick" Margin="2,0" Padding="8,4" FontSize="11" />
                                <Button Content=".exe" Style="{StaticResource SecondaryButton}" Tag=".exe" Click="OnQuickExtFilterClick" Margin="2,0" Padding="8,4" FontSize="11" />
                                <Button Content=".pdf" Style="{StaticResource SecondaryButton}" Tag=".pdf" Click="OnQuickExtFilterClick" Margin="2,0" Padding="8,4" FontSize="11" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="1.3*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Proportional Size TreeView -->
                        <DockPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock DockPanel.Dock="Top" Text="ARBORESCENCE PAR TAILLE RÉELLE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentCyan}" Margin="0,0,0,6" />
                            <TreeView ItemsSource="{Binding ExplorerRoots}" SelectedItemChanged="OnExplorerTreeSelectedChanged">
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate DataType="{x:Type models:FileNode}" ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal" Margin="0,1">
                                            <TextBlock Text="{Binding SizeFormatted}" Width="74" Foreground="{StaticResource AccentCyan}" FontWeight="SemiBold" FontSize="11.5" />
                                            <ProgressBar Value="{Binding PercentOfParent}" Maximum="100" Width="46" Height="6" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Name}" FontSize="12" />
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </DockPanel>

                        <!-- Right: Global Search Results & Top 250 Biggest Files -->
                        <DockPanel Grid.Column="1">
                            <TextBlock DockPanel.Dock="Top" Text="RÉSULTATS DE RECHERCHE GLOBALE &amp; PLUS GROS FICHIERS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentEmerald}" Margin="0,0,0,6" />
                            <DataGrid ItemsSource="{Binding ExplorerSearchResults}" SelectedItem="{Binding SelectedExplorerNode}" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Nom" Binding="{Binding Name}" Width="180" />
                                    <DataGridTextColumn Header="Taille" Binding="{Binding SizeFormatted}" Width="86" />
                                    <DataGridTextColumn Header="Modifié" Binding="{Binding LastWriteFormatted}" Width="88" />
                                    <DataGridTextColumn Header="Emplacement complet" Binding="{Binding FullPath}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Grid>
                </DockPanel>

                <!-- TAB 2: DEEP CACHE CLEANER -->
                <DockPanel Visibility="{Binding SelectedTabIndex, Converter={StaticResource TabVis}, ConverterParameter=2}">
                    <Border DockPanel.Dock="Top" Style="{StaticResource CardBorder}" Margin="0,0,0,12" Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Nettoyage Profond Multi-Caches (60+ Emplacements)" FontSize="17" FontWeight="Bold" />
                                <TextBlock Text="Nettoie Windows Temp, Shaders GPU (NVIDIA/AMD/Intel), caches Navigateurs (zéro mot de passe/cookie touché), Discord, Spotify, Steam, Adobe et outils Dev."
                                           FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Analyser Caches" Style="{StaticResource CyanButton}" Command="{Binding ScanCachesCommand}" Margin="0,0,6,0" />
                                <Button Content="Cocher 100% Sûr" Style="{StaticResource SecondaryButton}" Command="{Binding SelectSafeCachesCommand}" Margin="0,0,6,0" />
                                <Button Content="Tout décocher" Style="{StaticResource SecondaryButton}" Command="{Binding UnselectAllCachesCommand}" Margin="0,0,6,0" />
                                <Button Content="Nettoyer Sélection" Style="{StaticResource PrimaryButton}" Command="{Binding CleanSelectedCachesCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <DataGrid ItemsSource="{Binding CacheCandidates}">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="✓" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="40" />
                            <DataGridTextColumn Header="Catégorie" Binding="{Binding GroupName}" Width="175" IsReadOnly="True" />
                            <DataGridTextColumn Header="Cache détecté" Binding="{Binding DisplayName}" Width="225" IsReadOnly="True" />
                            <DataGridTextColumn Header="Sûreté" Binding="{Binding SafetyBadge}" Width="92" IsReadOnly="True" />
                            <DataGridTextColumn Header="Taille" Binding="{Binding SizeFormatted}" Width="88" IsReadOnly="True" />
                            <DataGridTextColumn Header="Fichiers" Binding="{Binding ItemCount}" Width="68" IsReadOnly="True" />
                            <DataGridTextColumn Header="Détail" Binding="{Binding Description}" Width="*" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>

                <!-- TAB 3: POST-STUDIES / GRADUATION CLEANUP -->
                <DockPanel Visibility="{Binding SelectedTabIndex, Converter={StaticResource TabVis}, ConverterParameter=3}">
                    <Border DockPanel.Dock="Top" Style="{StaticResource CardBorder}" Margin="0,0,0,12" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Mode Spécial « Fin d'Études / Nouveau Départ »" FontSize="17" FontWeight="Bold" />
                                    <TextBlock Text="Débusque les dossiers lourds de projets (node_modules, .gradle, venv, target, bin/obj), vieux installeurs/ISO oubliés et anciens cours (> 6 mois) en revue manuelle 100 % sûre."
                                               FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Scanner Résidus Études" Style="{StaticResource CyanButton}" Command="{Binding ScanStudyCommand}" Margin="0,0,8,0" />
                                    <Button Content="Envoyer Sélection à la Corbeille" Style="{StaticResource PrimaryButton}" Command="{Binding CleanSelectedStudyCommand}" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Tout afficher" Style="{StaticResource SecondaryButton}" Tag="0" Click="OnStudyFilterClick" Margin="0,0,6,0" Padding="10,5" FontSize="11.5" />
                                <Button Content="Dossiers Build / Dev" Style="{StaticResource SecondaryButton}" Tag="1" Click="OnStudyFilterClick" Margin="0,0,6,0" Padding="10,5" FontSize="11.5" />
                                <Button Content="Installeurs &amp; Archives (.exe/.iso/.zip)" Style="{StaticResource SecondaryButton}" Tag="2" Click="OnStudyFilterClick" Margin="0,0,6,0" Padding="10,5" FontSize="11.5" />
                                <Button Content="Anciens Documents (> 6 mois)" Style="{StaticResource SecondaryButton}" Tag="3" Click="OnStudyFilterClick" Margin="0,0,16,0" Padding="10,5" FontSize="11.5" />
                                <TextBlock Text="Seuil anciens docs (jours) :" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,6,0" />
                                <TextBox Width="56" Text="{Binding StudyOldDays}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <DataGrid ItemsSource="{Binding StudyItems}">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="✓" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="40" />
                            <DataGridTextColumn Header="Type" Binding="{Binding KindBadge}" Width="140" IsReadOnly="True" />
                            <DataGridTextColumn Header="Élément" Binding="{Binding Name}" Width="210" IsReadOnly="True" />
                            <DataGridTextColumn Header="Taille" Binding="{Binding SizeFormatted}" Width="88" IsReadOnly="True" />
                            <DataGridTextColumn Header="Dernier accès" Binding="{Binding LastAccessFormatted}" Width="96" IsReadOnly="True" />
                            <DataGridTextColumn Header="Chemin" Binding="{Binding FullPath}" Width="*" IsReadOnly="True" />
                            <DataGridTemplateColumn Header="Action" Width="88">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Ouvrir" Style="{StaticResource SecondaryButton}" Padding="8,2" FontSize="11"
                                                Command="{Binding DataContext.OpenInExplorerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding FullPath}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>

                <!-- TAB 4: EXACT SHA-256 DUPLICATES -->
                <DockPanel Visibility="{Binding SelectedTabIndex, Converter={StaticResource TabVis}, ConverterParameter=4}">
                    <Border DockPanel.Dock="Top" Style="{StaticResource CardBorder}" Margin="0,0,0,12" Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Détecteur de Doublons Exact (Empreinte SHA-256)" FontSize="17" FontWeight="Bold" />
                                <TextBlock Text="Compare le contenu réel au bit près sur tous vos disques. L'original le plus propre de chaque groupe est VERROUILLÉ : impossible de supprimer toutes les copies !"
                                           FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Chercher Doublons" Style="{StaticResource CyanButton}" Command="{Binding ScanDuplicatesCommand}" Margin="0,0,8,0" />
                                <Button Content="Supprimer Doublons Cochés" Style="{StaticResource PrimaryButton}" Command="{Binding CleanSelectedDuplicatesCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <DataGrid ItemsSource="{Binding DuplicateRows}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Suppr." Width="56">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelectedForDelete, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding CanToggleDelete}"
                                                  HorizontalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Rôle" Binding="{Binding RoleLabel}" Width="145" IsReadOnly="True" />
                            <DataGridTextColumn Header="Groupe SHA-256" Binding="{Binding ShortHash}" Width="105" IsReadOnly="True" />
                            <DataGridTextColumn Header="Fichier" Binding="{Binding FileName}" Width="200" IsReadOnly="True" />
                            <DataGridTextColumn Header="Taille" Binding="{Binding SizeFormatted}" Width="86" IsReadOnly="True" />
                            <DataGridTextColumn Header="Dossier" Binding="{Binding DirectoryName}" Width="*" IsReadOnly="True" />
                            <DataGridTemplateColumn Header="Voir" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Ouvrir" Style="{StaticResource SecondaryButton}" Padding="8,2" FontSize="11"
                                                Command="{Binding DataContext.OpenInExplorerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding FullPath}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>

                <!-- TAB 5: GHOST SOFTWARE & RESIDUALS -->
                <DockPanel Visibility="{Binding SelectedTabIndex, Converter={StaticResource TabVis}, ConverterParameter=5}">
                    <Border DockPanel.Dock="Top" Style="{StaticResource CardBorder}" Margin="0,0,0,12" Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Logiciels Fantômes, Dossiers Orphelins &amp; Programmes Installés" FontSize="17" FontWeight="Bold" />
                                <TextBlock Text="Détecte les entrées mortes du Registre et dossiers résiduels d'anciens programmes désinstallés (éditeurs système, pilotes et antivirus strictement protégés)."
                                           FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Auditer Logiciels" Style="{StaticResource CyanButton}" Command="{Binding ScanGhostsCommand}" Margin="0,0,8,0" />
                                <Button Content="Nettoyer Fantômes Cochés" Style="{StaticResource PrimaryButton}" Command="{Binding CleanSelectedGhostsCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0">
                            <TextBlock DockPanel.Dock="Top" Text="FANTÔMES REGISTRE &amp; DOSSIERS ORPHELINS DÉTECTÉS (REVUE MANUELLE)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentAmber}" Margin="0,0,0,5" />
                            <DataGrid ItemsSource="{Binding GhostAndOrphans}">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Header="✓" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="40" />
                                    <DataGridTextColumn Header="Type" Binding="{Binding KindBadge}" Width="140" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Logiciel / Dossier" Binding="{Binding DisplayName}" Width="190" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Taille" Binding="{Binding SizeFormatted}" Width="86" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Chemin / Clé" Binding="{Binding PathOrKey}" Width="*" IsReadOnly="True" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>

                        <DockPanel Grid.Row="2">
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,5">
                                <TextBlock Text="LOGICIELS INSTALLÉS (TRIÉS PAR TAILLE)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentCyan}" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="Filtrer :" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBox Width="220" Text="{Binding InstalledAppQuery, UpdateSourceTrigger=PropertyChanged}" Padding="8,4" />
                                </StackPanel>
                            </Grid>
                            <DataGrid ItemsSource="{Binding InstalledApps}" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Programme" Binding="{Binding DisplayName}" Width="240" />
                                    <DataGridTextColumn Header="Éditeur" Binding="{Binding Publisher}" Width="170" />
                                    <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="90" />
                                    <DataGridTextColumn Header="Taille est." Binding="{Binding SizeFormatted}" Width="86" />
                                    <DataGridTextColumn Header="Statut" Binding="{Binding Reason}" Width="*" />
                                    <DataGridTemplateColumn Header="Désinstaller" Width="115">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Désinstaller" Style="{StaticResource SecondaryButton}" Padding="8,2" FontSize="11"
                                                        Command="{Binding DataContext.LaunchUninstallerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Grid>
                </DockPanel>

                <!-- TAB 6: BROKEN SHORTCUTS & EMPTY FOLDERS -->
                <DockPanel Visibility="{Binding SelectedTabIndex, Converter={StaticResource TabVis}, ConverterParameter=6}">
                    <Border DockPanel.Dock="Top" Style="{StaticResource CardBorder}" Margin="0,0,0,12" Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Raccourcis Inutiles / Morts &amp; Dossiers Vides" FontSize="17" FontWeight="Bold" />
                                <TextBlock Text="Détecte les raccourcis .lnk/.url pointant vers des programmes supprimés (sans toucher aux clés USB débranchées) ainsi que les dossiers vides résiduels."
                                           FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Scanner" Style="{StaticResource CyanButton}" Command="{Binding ScanShortcutsEmptyCommand}" Margin="0,0,8,0" />
                                <Button Content="Nettoyer Raccourcis" Style="{StaticResource PrimaryButton}" Command="{Binding CleanSelectedShortcutsCommand}" Margin="0,0,8,0" />
                                <Button Content="Nettoyer Dossiers Vides" Style="{StaticResource SecondaryButton}" Command="{Binding CleanSelectedEmptyFoldersCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <DockPanel Grid.Column="0">
                            <TextBlock DockPanel.Dock="Top" Text="RACCOURCIS CASSÉS (.LNK / .URL)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentAmber}" Margin="0,0,0,6" />
                            <DataGrid ItemsSource="{Binding BrokenShortcuts}">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Header="✓" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="40" />
                                    <DataGridTextColumn Header="Raccourci" Binding="{Binding ShortcutName}" Width="160" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Zone" Binding="{Binding LocationLabel}" Width="125" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Cible manquante" Binding="{Binding MissingTarget}" Width="*" IsReadOnly="True" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>

                        <DockPanel Grid.Column="2">
                            <TextBlock DockPanel.Dock="Top" Text="DOSSIERS 100% VIDES" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentCyan}" Margin="0,0,0,6" />
                            <DataGrid ItemsSource="{Binding EmptyFolders}">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Header="✓" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="40" />
                                    <DataGridTextColumn Header="Nom" Binding="{Binding FolderName}" Width="150" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Chemin complet" Binding="{Binding FullPath}" Width="*" IsReadOnly="True" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Grid>
                </DockPanel>

                <!-- TAB 7: SAFE HARDWARE-FREE OPTIMIZER & STARTUP MANAGER -->
                <ScrollViewer Visibility="{Binding SelectedTabIndex, Converter={StaticResource TabVis}, ConverterParameter=7}" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Profile Cards -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Optimiseur Selon Vos Envies — 0 % Risque Matériel &amp; 100 % Réversible" FontSize="17" FontWeight="Bold" />
                                        <TextBlock Text="Choisissez un profil ou ajustez chaque réglage ci-dessous. Une sauvegarde JSON automatique est enregistrée avant toute modification."
                                                   FontSize="12" Foreground="{StaticResource TextSecondary}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Content="Créer Point de Restauration Windows" Style="{StaticResource SecondaryButton}" Command="{Binding CreateWindowsRestorePointCommand}" Margin="0,0,8,0" />
                                        <Button Content="Appliquer les Réglages Cochés" Style="{StaticResource PrimaryButton}" Command="{Binding ApplyOptimizerCommand}" />
                                    </StackPanel>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding OptimizerProfiles}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="4" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource BgElevated}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="9" Padding="12" Margin="4">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Bottom" Content="Choisir ce profil" Style="{StaticResource CyanButton}" Padding="10,6" FontSize="11.5" Margin="0,10,0,0"
                                                            Command="{Binding DataContext.SelectOptimizerProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,5,0,0" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Individual Safe Tweaks -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{Binding ActiveProfileLabel, StringFormat='RÉGLAGES SÛRS DISPONIBLES (PROFIL : {0})'}" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource AccentEmerald}" Margin="0,0,0,8" />
                                <DataGrid ItemsSource="{Binding OptimizerTweaks}" MaxHeight="290">
                                    <DataGrid.Columns>
                                        <DataGridCheckBoxColumn Header="Appliquer" Binding="{Binding IsEnabledByUser, UpdateSourceTrigger=PropertyChanged}" Width="68" />
                                        <DataGridTextColumn Header="État actuel" Binding="{Binding CurrentStatusLabel}" Width="118" IsReadOnly="True" />
                                        <DataGridTextColumn Header="Catégorie" Binding="{Binding Category}" Width="155" IsReadOnly="True" />
                                        <DataGridTextColumn Header="Réglage Windows" Binding="{Binding Title}" Width="280" IsReadOnly="True" />
                                        <DataGridTextColumn Header="Effet réel" Binding="{Binding Description}" Width="*" IsReadOnly="True" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <!-- 1-Click Snapshot Restoration -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="RESTAURATION 1-CLIC À L'ÉTAT D'ORIGINE WINDOWS" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource AccentAmber}" Margin="0,0,0,6" />
                                    <ComboBox ItemsSource="{Binding SavedSnapshots}" SelectedItem="{Binding SelectedSnapshot}" DisplayMemberPath="DisplayLabel" MaxWidth="560" HorizontalAlignment="Left" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Restaurer cette Sauvegarde" Style="{StaticResource AmberButton}" Command="{Binding RestoreSelectedSnapshotCommand}" VerticalAlignment="Bottom" />
                            </Grid>
                        </Border>

                        <!-- Safe Startup Manager -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="PROGRAMMES AU DÉMARRAGE WINDOWS (ANTIVIRUS &amp; PILOTES VERROUILLÉS)" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource AccentCyan}" VerticalAlignment="Center" />
                                    <Button Content="Rafraîchir" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshStartupCommand}" HorizontalAlignment="Right" Padding="10,4" FontSize="11.5" />
                                </Grid>
                                <DataGrid ItemsSource="{Binding StartupApps}" MaxHeight="260" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Application" Binding="{Binding Name}" Width="180" />
                                        <DataGridTextColumn Header="Niveau Sécurité" Binding="{Binding RiskBadge}" Width="145" />
                                        <DataGridTextColumn Header="Source" Binding="{Binding SourceLocation}" Width="170" />
                                        <DataGridTextColumn Header="Commande" Binding="{Binding Command}" Width="*" />
                                        <DataGridTemplateColumn Header="État" Width="125">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource SecondaryButton}" Padding="8,3" FontSize="11"
                                                            Command="{Binding DataContext.ToggleStartupAppCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}">
                                                        <Button.Content>
                                                            <TextBlock Text="{Binding IsEnabled, StringFormat='Actif: {0}'}" />
                                                        </Button.Content>
                                                    </Button>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
