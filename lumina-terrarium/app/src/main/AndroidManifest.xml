<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <uses-feature android:name="android.hardware.sensor.stepcounter" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher_terrarium"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher_terrarium"
        android:supportsRtl="true"
        android:theme="@style/Theme.LuminaTerrarium">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.LuminaTerrarium">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.TerrariumWidgetProvider"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.newww.luminaterrarium.ACTION_WIDGET_PET" />
                <action android:name="com.newww.luminaterrarium.ACTION_WIDGET_FEED" />
                <action android:name="com.newww.luminaterrarium.ACTION_WIDGET_MIST" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/terrarium_widget_info" />
        </receiver>
    </application>

</manifest>
